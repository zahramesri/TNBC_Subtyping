#### Biomarker selection -----------------------------------------------------

# per-sample mean and SD across all z-score genes
sample_stats <- data.frame(
  mean = sapply(zscore, mean),
  SD   = sapply(zscore, sd)
)

write.xlsx(as.data.frame(sample_stats), rowNames = TRUE,
           file = "output/Mean_SD_celltype_markers.xlsx")

# for each CC subtype, flag genes in the top 20th percentile (pnorm >= 0.80)
# in >= 50% of samples, using per-sample mean/SD as the null distribution
cc_names  <- c("CC1", "CC2", "CC3")

biomarkers <- lapply(cc_names, function(cc) {
  cc_samples <- rownames(coldata[coldata$CC == cc, ])
  zscore_cc  <- marker_zscore[, cc_samples]
  stats_cc   <- sample_stats[cc_samples, ]
  
  pnorm_mat <- mapply(function(s) {
    pnorm(zscore_cc[, s], mean = stats_cc[s, "mean"], sd = stats_cc[s, "SD"])
  }, cc_samples)
  rownames(pnorm_mat) <- rownames(zscore_cc)
  
  keep <- rowSums(pnorm_mat >= 0.80) >= round(ncol(pnorm_mat) / 2)
  rownames(zscore_cc)[keep]
})
names(biomarkers) <- cc_names

sink("output/Biomarkers_top20percentile_perCC.txt")
print(biomarkers)
sink()
