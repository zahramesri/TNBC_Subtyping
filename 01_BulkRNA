#### DEA ---------------------------------------------------------------------

dds <- DESeqDataSetFromMatrix(countData = counts, colData = coldata, design = ~Race)
dds <- dds[rowSums(fpm(dds, robust = TRUE) > 1) >= 2]
dds <- DESeq(dds)
vsd <- vst(dds, blind = FALSE)

plotPCA(vsd, intgroup = "Race")

zscore <- as.data.frame(t(scale(t(assay(vsd)), center = TRUE, scale = TRUE)))
zscore_filtered <- zscore[rowSums(zscore >= 2) > 0 & rowSums(zscore <= -2) > 0, ]

vsd_counts <- assay(vsd)


#### Consensus clustering ----------------------------------------------------

cell_markers <- as.data.frame(read_excel("data/Cell_type_Marker.xlsx")) # Supplementary Table 1
marker_zscore <- zscore_filtered[rownames(zscore_filtered) %in% cell_markers$gene, ]

results <- ConsensusClusterPlus(
  as.matrix(marker_zscore),
  maxK = 20, reps = 1000, pItem = 0.8, pFeature = 1,
  title = "output/ConsensusCluster",
  clusterAlg = "hc", distance = "spearman",
  seed = 1262118388.71279, plot = "png"
)

#### Biomarker selection -----------------------------------------------------

# per-sample mean and SD across all z-score genes
sample_stats <- data.frame(
  mean = sapply(zscore, mean),
  SD   = sapply(zscore, sd)
)

write.xlsx(as.data.frame(sample_stats), rowNames = TRUE,
           file = "output/Mean_SD_celltype_markers.xlsx")

# for each CC subtype, flag genes in the top 20th percentile (pnorm >= 0.80)
# in >= 50% of samples, using per-sample mean/SD as the null distribution
cc_names  <- c("CC1", "CC2", "CC3")

biomarkers <- lapply(cc_names, function(cc) {
  cc_samples <- rownames(coldata[coldata$CC == cc, ])
  zscore_cc  <- marker_zscore[, cc_samples]
  stats_cc   <- sample_stats[cc_samples, ]
  
  pnorm_mat <- mapply(function(s) {
    pnorm(zscore_cc[, s], mean = stats_cc[s, "mean"], sd = stats_cc[s, "SD"])
  }, cc_samples)
  rownames(pnorm_mat) <- rownames(zscore_cc)
  
  keep <- rowSums(pnorm_mat >= 0.80) >= round(ncol(pnorm_mat) / 2)
  rownames(zscore_cc)[keep]
})
names(biomarkers) <- cc_names

sink("output/Biomarkers_top20percentile_perCC.txt")
print(biomarkers)
sink()


#### DEA: subtype-specific ####
#Note coldata = metadata
coldata <- coldata %>%
  mutate(
    DEA_CC1 = if_else(CC == "CC1", "CC1", "other"),
    DEA_CC2 = if_else(CC == "CC2", "CC2", "other"),
    DEA_CC3 = if_else(CC == "CC3", "CC3", "other")
  )

DEGs_sig <- function(dds_obj, contrast_name) {
  df <- as.data.frame(results(dds_obj))
  df$Gene      <- rownames(df)
  df$Direction <- ifelse(df$log2FoldChange > 0, "upregulated", "downregulated")
  df$Contrast  <- contrast_name
  df
}

run_deseq <- function(cts, coldata, design_var) {
  dds <- DESeqDataSetFromMatrix(countData = cts, colData = coldata,
                                design = as.formula(paste("~", design_var)))
  dds <- dds[rowSums(fpm(dds, robust = TRUE) > 1) >= 2]
  DESeq(dds)
}

dds_CC1 <- run_deseq(cts, coldata, "DEA_CC1")
dds_CC2 <- run_deseq(cts, coldata, "DEA_CC2")
dds_CC3 <- run_deseq(cts, coldata, "DEA_CC3")

All_DEGs <- bind_rows(
  DEGs_sig(dds_CC1, "CC1"),
  DEGs_sig(dds_CC2, "CC2"),
  DEGs_sig(dds_CC3, "CC3")
)

All_DEGs_sig <- All_DEGs %>% filter(padj <= 0.05)

write.xlsx(
  list(All_DEGs = All_DEGs, All_DEGs_sig = All_DEGs_sig),
  "results/BULK_DEGs.xlsx"
)

#### fGSEA ####

msigdb_h  <- msigdbr(species = "Homo sapiens", category = "H")
gene_sets <- split(msigdb_h$gene_symbol, msigdb_h$gs_name)

fgsea_results <- lapply(unique(All_DEGs$Contrast), function(cc) {
  df <- All_DEGs %>%
    filter(Contrast == cc, !is.na(padj)) %>%
    mutate(rank_score = sign(log2FoldChange) * -log10(padj)) %>%
    distinct(Gene, .keep_all = TRUE)
  
  if (nrow(df) < 30) return(NULL)
  
  ranks        <- setNames(df$rank_score, df$Gene)
  res          <- fgsea(pathways = gene_sets, stats = ranks, minSize = 15, maxSize = 500)
  res$Contrast <- cc
  res
})

fgsea_H <- bind_rows(fgsea_results) %>%
  arrange(Contrast, padj, desc(NES))

fgsea_sig <- fgsea_H %>% filter(padj < 0.05)

write.xlsx(list(fgsea_H = fgsea_H), "results/BULK_CC_fGSEA.xlsx")
