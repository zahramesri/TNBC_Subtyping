#### Race distribution -------------------------------------------------------

compute_CC_significance <- function(df, target_var) {
  target_var <- rlang::ensym(target_var)
  
  counts_wide <- df %>%
    group_by(CC, !!target_var) %>%
    summarise(n = n(), .groups = "drop") %>%
    pivot_wider(names_from = !!target_var, values_from = n, values_fill = 0)
  
  cat_cols    <- names(counts_wide)[-1]
  n_cat       <- length(cat_cols)
  global_dist <- prop.table(table(df %>% pull(!!target_var)))
  
  counts_wide %>%
    rowwise() %>%
    mutate(
      observed = list(c(across(all_of(cat_cols)))),
      expected = list(as.numeric(global_dist) * sum(unlist(observed))),
      p_value = if (n_cat == 2) {
        binom.test(unlist(observed)[2], sum(unlist(observed)), p = 0.5)$p.value
      } else {
        chisq.test(x = unlist(observed), p = as.numeric(global_dist))$p.value
      },
      signif = case_when(
        p_value < 0.001 ~ "***",
        p_value < 0.01  ~ "**",
        p_value < 0.05  ~ "*",
        TRUE ~ "ns"
      )
    ) %>%
    ungroup()
}

plot_CC_distribution <- function(results_table, title = NULL, palette = NULL) {
  cat_cols <- names(results_table)[!names(results_table) %in%
                                     c("CC", "signif", "p_value", "observed", "expected")]
  
  df_long <- results_table %>%
    select(CC, all_of(cat_cols)) %>%
    pivot_longer(cols = all_of(cat_cols), names_to = "Category", values_to = "Count")
  
  star_pos <- results_table %>%
    mutate(max_y = rowSums(across(all_of(cat_cols))),
           y_pos = max_y + max(max_y) * 0.08) %>%
    select(CC, signif, y_pos)
  
  if (is.null(palette)) palette <- scales::hue_pal()(length(cat_cols))
  
  ggplot(df_long, aes(x = CC, y = Count, fill = Category)) +
    geom_bar(stat = "identity") +
    geom_text(data = star_pos, aes(x = CC, y = y_pos, label = signif),
              inherit.aes = FALSE, size = 4, fontface = "bold") +
    scale_fill_manual(values = palette) +
    labs(title = title, x = "TNBC Subtype (CC)", y = "Number of Patients", fill = NULL) +
    theme_bw(base_size = 14) +
    theme(plot.title = element_text(face = "bold", size = 14),
          legend.position = "right")
}

