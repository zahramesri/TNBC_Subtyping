#### TPM conversion (for EcoTyper input) -------------------------------------

get_gene_lengths <- function(gene_symbols) {
  entrez_ids <- mapIds(org.Hs.eg.db, keys = gene_symbols,
                       column = "ENTREZID", keytype = "SYMBOL", multiVals = "first")
  gene_info <- select(org.Hs.eg.db, keys = entrez_ids,
                      columns = c("CHRLOC","CHRLOCEND"), keytype = "ENTREZID") %>%
    mutate(gene_length        = abs(CHRLOCEND - CHRLOC),
           external_gene_name = names(entrez_ids)[match(ENTREZID, entrez_ids)]) %>%
    na.omit()
  gene_info[match(gene_symbols, gene_info$external_gene_name), ]
}

counts_to_tpm <- function(counts, gene_lengths) {
  keep         <- !is.na(gene_lengths$gene_length)
  counts_filt  <- counts[keep, ]
  lengths_filt <- gene_lengths$gene_length[keep]
  rpk <- counts_filt / lengths_filt
  tpm <- t(t(rpk) * 1e6 / colSums(rpk))
  list(tpm = tpm, log_tpm = log2(tpm))
}

gene_lengths_pos <- get_gene_lengths(rownames(counts_pos))
gene_lengths_neg <- get_gene_lengths(rownames(counts_neg))

res_tpm_pos <- counts_to_tpm(counts_pos, gene_lengths_pos)
res_tpm_neg <- counts_to_tpm(counts_neg, gene_lengths_neg)

