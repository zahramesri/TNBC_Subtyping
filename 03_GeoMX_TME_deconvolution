meta_slim$CC_Region <- paste0(meta_slim$ConsensusCluster, "-", meta_slim$Region)
meta_unique <- meta_slim %>% distinct(`slide name`, .keep_all = TRUE)

plot_cell_histograms <- function(prop_matrix, outfile) {
  cellnames <- rownames(prop_matrix)
  pdf(outfile, width = 15, height = 10)
  for (cell in cellnames) {
    x_cells <- reshape2::melt(prop_matrix[cell, ]) %>%
      rownames_to_column("AOI") %>%
      mutate(`slide name` = sub("\\..*", "", AOI))
    x_cells_meta <- merge(x_cells, meta_unique, by = "slide name") %>%
      mutate(CC_Region = as.factor(CC_Region))
    p <- ggplot(x_cells_meta, aes(x = value, fill = CC_Region)) +
      geom_histogram(binwidth = 0.05, color = "grey", position = "identity") +
      geom_vline(xintercept = c(0.25, 0.5, 0.75), linetype = "dashed") +
      labs(title = paste("Cell proportions:", cell), x = cell, y = "Frequency") +
      theme_minimal() + ylim(0, 75) + xlim(0, 0.75) +
      facet_wrap(~CC_Region, scales = "free_y") +
      theme(axis.text        = element_text(size = 12, face = "bold"),
            axis.title       = element_text(face = "bold", size = 12),
            panel.background = element_blank(),
            panel.grid       = element_blank())
    print(p)
  }
  dev.off()
}

