write_ecotyper_inputs <- function(tpm_mat, geomx_obj, tpm_file, annot_file) {
  tpm_df   <- rownames_to_column(as.data.frame(tpm_mat), var = "Gene")
  annot_df <- rownames_to_column(as.data.frame(pData(geomx_obj)), var = "ID")
  annot_df$ID <- gsub("-", ".", annot_df$ID)
  write.table(tpm_df,   file = tpm_file,   sep = "\t", row.names = FALSE, col.names = TRUE, quote = FALSE)
  write.table(annot_df, file = annot_file, sep = "\t", row.names = FALSE, col.names = TRUE, quote = FALSE)
}

