#### EcoTyper state assignment -----------------------------------------------
# Uses SpatialDecon proportions (reordered_props_major) weighted by EcoTyper
# state abundances to assign dominant cell states per AOI

ecotyper_dir <- "output/EcoTyper_PanNeg/TPM_PanNeg/"

celltypes <- c("B.cells","Dendritic.cells","Endothelial.cells",
               "Fibroblasts","Monocytes.and.Macrophages","PCs")

celltype_map <- list(
  B.cells                   = "B-cells",
  Dendritic.cells           = "Myeloid",
  Endothelial.cells         = "Endothelial",
  Fibroblasts               = "Fibroblast/Mesenchymal",
  Monocytes.and.Macrophages = "Myeloid",
  PCs                       = "Plasmablasts"
)

abundance <- lapply(setNames(celltypes, celltypes), function(cell) {
  data.frame(t(read.delim(file.path(ecotyper_dir, cell, "state_abundances.txt"))))
})

check_exceed_and_append <- function(row, threshold) {
  max_col <- names(row)[which.max(row)]
  if (max(row) > threshold) max_col else NA_character_
}

meta_id <- pData(TNBC_downstream_PanNeg) %>%
  select(ROI_REL) %>%
  mutate(ID = gsub("-", ".", rownames(.)))

group_df <- data.frame(
  ID     = meta_id$ID,
  Group  = TNBC_downstream_PanNeg$ConsensusCluster,
  Region = TNBC_downstream_PanNeg$Region
)

align_matrix_ids <- function(prop_matrix, meta_id) {
  mat <- as.data.frame(t(prop_matrix)) %>% rownames_to_column("ROI_REL")
  mat$ROI_REL_prefix <- sub("^(.*?\\..*?)\\..*", "\\1", mat$ROI_REL)
  meta_prefix <- meta_id %>%
    mutate(ROI_REL_prefix = sub("^(.*?\\..*?)\\..*", "\\1", ROI_REL))
  mat <- merge(mat, meta_prefix, by = "ROI_REL_prefix") %>%
    select(-ROI_REL.x, -ROI_REL_prefix, -ROI_REL.y) %>%
    column_to_rownames("ID")
  as.data.frame(t(mat))
}

props_major_aligned <- align_matrix_ids(reordered_props_major, meta_id)

assign_cell_states <- function(cell, threshold_q = 0.8) {
  prop_col  <- celltype_map[[cell]]
  abund_mat <- abundance[[cell]]
  prop_mat  <- props_major_aligned[, rownames(abund_mat)]
  prop_vals <- as.data.frame(t(prop_mat))[[prop_col]]
  weighted  <- apply(t(as.data.frame(abund_mat)), 1, function(row) row * prop_vals)
  val       <- quantile(reshape2::melt(weighted)$value, threshold_q)
  apply(as.data.frame(weighted), 1, check_exceed_and_append, threshold = as.numeric(val)) %>%
    as.data.frame() %>% setNames("State") %>%
    filter(!is.na(State)) %>%
    mutate(cellType = cell, ID = rownames(.)) %>%
    merge(group_df, by = "ID")
}

assignment2 <- lapply(setNames(celltypes, celltypes), assign_cell_states)


#### Add EcoTyper state labels -----------------------------------------------

state_labels <- read_xlsx("data/Ecotyper_cell_state_reference.xlsx", sheet = "S4A") %>%
  select(1:4) %>% drop_na() %>%
  setNames(.[1, ]) %>% slice(-1) %>%
  mutate(`Cell type` = recode(`Cell type`,
                              "B cells"               = "B.cells",
                              "Endothelial cells"     = "Endothelial.cells",
                              "Dendritic cells"       = "Dendritic.cells",
                              "Fibroblasts"           = "Fibroblasts",
                              "Monocytes/Macrophages" = "Monocytes.and.Macrophages",
                              "Plasma cells"          = "PCs"
  )) %>% drop_na()

assignment2_labeled <- lapply(celltypes, function(x) {
  df <- merge(assignment2[[x]], state_labels[state_labels$`Cell type` == x, ],
              by.x = "State", by.y = "Cell state", all.x = TRUE)
  df$`Cell state annotation`[is.na(df$`Cell state annotation`)] <-
    paste0("Unknown (", df$State[is.na(df$`Cell state annotation`)], ")")
  df$`Cell state annotation` <- factor(df$`Cell state annotation`,
                                       levels = unique(df$`Cell state annotation`[order(df$State)]))
  df
}) %>% setNames(celltypes)

write.xlsx(assignment2_labeled, file = "output/TNBC_EcoTyper_states_major.xlsx", overwrite = TRUE)


