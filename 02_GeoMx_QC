#### Pre QC Plots ####----------------------------------------------------------------------------------------------

pData(TNBC_data_shifted)$area <- as.numeric(pData(TNBC_data_shifted)$area)

col_by <- "segment"

QC_histogram <- function(assay_data, annotation, fill_by, thr, scale_trans = NULL) {
  plt <- ggplot(assay_data, aes(x = .data[[annotation]], fill = .data[[fill_by]])) +
    geom_histogram(bins = 50) +
    geom_vline(xintercept = thr, lty = "dashed", color = "black") +
    theme_bw() + guides(fill = "none") +
    facet_wrap(as.formula(paste("~", fill_by)), nrow = 4) +
    labs(x = annotation, y = "Segments, #", title = annotation)
  if (!is.null(scale_trans))
    plt <- plt + scale_x_continuous(trans = scale_trans)
  plt
}

