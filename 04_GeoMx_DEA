#### LMM helper functions ####

format_lmm_results <- function(results2, subset) {
  results2$Color <- "NS"
  results2$Color[results2$`Pr(>|t|)` < 0.05]  <- "P < 0.05"
  results2$Color[results2$FDR < 0.05]          <- "FDR < 0.05"
  results2$Color[results2$FDR < 0.001]         <- "FDR < 0.001"
  results2$Color <- factor(results2$Color,
                           levels = c("NS", "P < 0.05", "FDR < 0.05", "FDR < 0.001"))
  
  results2$invert_P <- (-log10(results2$`Pr(>|t|)`)) * sign(results2$Estimate)
  top_g <- c()
  for (cond in subset) {
    ind   <- results2$Subset == cond
    top_g <- c(top_g,
               results2[ind, "Gene"][order(results2[ind, "invert_P"], decreasing = TRUE)[1:15]],
               results2[ind, "Gene"][order(results2[ind, "invert_P"], decreasing = FALSE)[1:15]])
  }
  results2$invert_P <- NULL
  
  list(results = results2, top_g = unique(top_g))
}

# Within-slide comparison (random slope for testClass)
runLMM_within <- function(subset, categoryName, targetData,
                          interceptNum, interceptDenom, testClass) {
  results2 <- NULL
  for (rely in subset) {
    ind  <- pData(targetData)[, categoryName] == rely
    newD <- targetData[, ind]
    pData(newD)$testClass         <- factor(pData(newD)[[testClass]])
    pData(newD)[["interceptNum"]] <- factor(pData(newD)[[interceptNum]])
    pData(newD)[["interceptDenom"]] <- factor(pData(newD)[[interceptDenom]])
    
    mixedOutmc <- mixedModelDE(newD,
                               elt          = "log_q",
                               modelFormula = ~ testClass + (1 + testClass | interceptNum/interceptDenom),
                               groupVar     = "testClass",
                               nCores       = parallel::detectCores(),
                               multiCore    = TRUE)
    
    r_test          <- as.data.frame(do.call(rbind, mixedOutmc["lsmeans", ]))
    r_test$Contrast <- rownames(r_test)
    r_test$Gene     <- unlist(lapply(colnames(mixedOutmc), rep, nrow(mixedOutmc["lsmeans", ][[1]])))
    r_test$Subset   <- rely
    r_test$FDR      <- p.adjust(r_test$`Pr(>|t|)`, method = "fdr")
    r_test          <- r_test[, c("Gene", "Subset", "Contrast", "Estimate", "Pr(>|t|)", "FDR")]
    results2        <- rbind(results2, r_test)
  }
  format_lmm_results(results2, subset)
}

# Across-slide comparison (random intercept only)
runLMM_across <- function(subset, subsetName, targetData,
                          interceptNum, interceptDenom, testClass) {
  results2 <- NULL
  for (rely in subset) {
    ind  <- pData(targetData)[, subsetName] == rely
    newD <- targetData[, ind]
    pData(newD)$testClass           <- factor(pData(newD)[[testClass]])
    pData(newD)[["interceptNum"]]   <- factor(pData(newD)[[interceptNum]])
    pData(newD)[["interceptDenom"]] <- factor(pData(newD)[[interceptDenom]])
    
    mixedOutmc <- mixedModelDE(newD,
                               elt          = "log_q",
                               modelFormula = ~ testClass + (1 | interceptNum/interceptDenom),
                               groupVar     = "testClass",
                               nCores       = parallel::detectCores(),
                               multiCore    = FALSE)
    
    r_test          <- as.data.frame(do.call(rbind, mixedOutmc["lsmeans", ]))
    r_test$Contrast <- rownames(r_test)
    r_test$Gene     <- unlist(lapply(colnames(mixedOutmc), rep, nrow(mixedOutmc["lsmeans", ][[1]])))
    r_test$Subset   <- rely
    r_test$FDR      <- p.adjust(r_test$`Pr(>|t|)`, method = "fdr")
    r_test          <- r_test[, c("Gene", "Subset", "Contrast", "Estimate", "Pr(>|t|)", "FDR")]
    results2        <- rbind(results2, r_test)
  }
  format_lmm_results(results2, subset)
}

